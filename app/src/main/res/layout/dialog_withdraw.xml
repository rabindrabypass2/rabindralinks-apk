<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Redeem Points"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minimum payout: 1,000 PTS ($1.00 USD)"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/etPayoutAccount"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Enter UPI ID / bKash / PayPal Email"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_task_card"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="16dp"
        android:inputType="textEmailAddress" />

    <EditText
        android:id="@+id/etPointsToRedeem"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Points to redeem (e.g. 1000)"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_task_card"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="12dp"
        android:inputType="number" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnCancelWithdraw"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_task_card"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmWithdraw"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Redeem"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_accent"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
